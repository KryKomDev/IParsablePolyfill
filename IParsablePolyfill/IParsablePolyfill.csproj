<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;netstandard2.1;net5.0;net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <IsPackable>true</IsPackable>

        <RootNamespace>IParsablePolyfill</RootNamespace>
        <AssemblyName>IParsablePolyfill</AssemblyName>
        <Authors>KryKomDev</Authors>
        <Description>A polyfill for IParsable</Description>
        <PackageIcon>Package-Icon.png</PackageIcon>
        <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
        <PackageReadmeFile>Package-Readme.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/KryKomDev/IParsablePolyfill</RepositoryUrl>
        
<!--        <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>-->
<!--        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>-->
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Implyzer" Version="2026.5.3" />
        <PackageReference Include="Polyfill" Version="11.2.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>
    
    <ItemGroup>
        <None Include="../Assets/Package-Icon.png" Pack="true" PackagePath=""/>
        <None Include="../Assets/Package-Readme.md" Pack="true" PackagePath=""/>
        <None Include="../LICENSE.md" Pack="true" PackagePath=""/>
    </ItemGroup>
    
</Project>
